# App
APP_ENV=development
DEBUG=false
DEMO_MODE=true
STORAGE_PATH=./data

# vLLM / AMD
# Local default: http://127.0.0.1:8000/v1
# AMD VM default:  http://127.0.0.1:8000/v1 and expose only FastAPI publicly.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=token-abc123
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=token-abc123
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
QWEN_ENABLED=false

# Frontend / deployment
# Multiple origins can be comma-separated if you expose Vercel/Hugging Face later.
CORS_ORIGINS=http://localhost:3000
MAX_BATCH_SIZE=16
ENABLE_AMD_METRICS=true
HF_TOKEN=

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_TOKEN_SECRET=change-me-random-secret
ADMIN_TOKEN_EXPIRE_MINUTES=720
