# App
APP_ENV=production
DEBUG=false
DEMO_MODE=false
STORAGE_PATH=./data

# vLLM / AMD
# AMD VM should keep Qwen internal on 127.0.0.1 and expose only FastAPI publicly.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=amd-qwen-demo-key
VLLM_MODEL=Qwen/Qwen2-7B-Instruct
VLLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=amd-qwen-demo-key
QWEN_MODEL=Qwen/Qwen2-7B-Instruct
QWEN_ENABLED=true

# Frontend / deployment
CORS_ORIGINS=https://YOUR_SPACE.hf.space
MAX_BATCH_SIZE=16
ENABLE_AMD_METRICS=true
HF_TOKEN=

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_SECRET=relieflens-demo-secret-change-this
ADMIN_TOKEN_EXPIRE_MINUTES=720
